---
import '../styles/global.css';
import site from '../data/site.json';
import { SITE_NAME, SITE_NAME_EN, SITE_TAGLINE } from '../lib/utils.js';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const { title, description = SITE_TAGLINE, active = '' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · ${SITE_NAME_EN}`;
const nav = [
  ['/', '首页', 'home'],
  ['/daily/', '每日报告', 'daily'],
  ['/news/', '行业动态', 'news'],
  ['/specials/', '专题', 'specials'],
  ['/papers/', '论文库', 'papers'],
  ['/topics/', '研究方向', 'topics'],
  ['/applications/', '应用领域', 'domains'],
  ['/about/', '关于', 'about'],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#4338ca" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="QuantOpt" />
    <script is:inline>
      (function () {
        try { document.documentElement.dataset.theme = localStorage.getItem('qo-theme') || 'dark'; } catch (e) { document.documentElement.dataset.theme = 'dark'; }
      })();
    </script>
  </head>
  <body>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">
          <span class="logo">Q</span>
          <span>{SITE_NAME}</span>
        </a>
        <div class="side-group">
          <div class="side-label">内容</div>
          <a class="side-link" href="/" class:list={[active === 'home' && 'active']}><span class="ico">🏠</span>首页</a>
          <a class="side-link" href="/daily/" class:list={[active === 'daily' && 'active']}><span class="ico">📅</span>每日报告</a>
          <a class="side-link" href="/weekly/" class:list={[active === 'weekly' && 'active']}><span class="ico">🗓️</span>周报</a>
          <a class="side-link" href="/monthly/" class:list={[active === 'monthly' && 'active']}><span class="ico">🗓️</span>月报</a>
          <a class="side-link" href="/news/" class:list={[active === 'news' && 'active']}><span class="ico">📣</span>行业动态</a>
          <a class="side-link" href="/specials/" class:list={[active === 'specials' && 'active']}><span class="ico">🧭</span>专题</a>
        </div>
        <div class="side-group">
          <div class="side-label">文献</div>
          <a class="side-link" href="/papers/" class:list={[active === 'papers' && 'active']}><span class="ico">📚</span>论文库</a>
          <a class="side-link" href="/topics/" class:list={[active === 'topics' && 'active']}><span class="ico">🔬</span>研究方向</a>
          <a class="side-link" href="/applications/" class:list={[active === 'domains' && 'active']}><span class="ico">🏭</span>应用领域</a>
        </div>
        <div class="side-group">
          <div class="side-label">更多</div>
          <a class="side-link" href="/about/"><span class="ico">ℹ️</span>关于本站</a>
          <a class="side-link" href="/rss.xml"><span class="ico">📡</span>RSS 订阅</a>
          <a class="side-link" href="/app/QuantOptDaily-v1.0.0.apk"><span class="ico">📱</span>安卓 App</a>
        </div>
        <div class="side-foot">
          <button class="theme-btn" id="themeToggle" type="button">🌗 切换深浅主题</button>
        </div>
      </aside>
      <div class="main-col">
        <header class="site-header">
          <div class="wrap">
            <a class="brand" href="/">
              <span class="logo">Q</span>
              <span>{SITE_NAME}<span class="sub">{SITE_NAME_EN}</span></span>
            </a>
            <button class="theme-toggle-mobile" id="themeToggleM" type="button" aria-label="切换深浅主题">🌗</button>
            <nav class="nav" aria-label="主导航">
          {nav.map(([href, label, key]) => (
            <a href={href} class={active === key ? 'active' : ''}>{label}</a>
          ))}
          <a href="/rss.xml" class="rss" title="RSS 订阅">RSS</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <strong>{SITE_NAME}</strong> · {SITE_NAME_EN}<br />
          由每日自动检索流水线生成 · 数据更新至 <span class="mono">{site.lastUpdated}</span> · 共收录 {site.stats.papers} 篇论文
        </div>
        <div>
          数据来源:arXiv · OpenAlex · Semantic Scholar 等 · <a href="/about/">关于本站</a> · <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
      </div>
    </div>

    <nav class="bottom-nav" aria-label="移动端导航">
      <div class="inner">
        <a href="/" class={active === 'home' ? 'active' : ''}><span class="ico">🏠</span>首页</a>
        <a href="/daily/" class={active === 'daily' ? 'active' : ''}><span class="ico">📅</span>日报</a>
        <a href="/news/" class={active === 'news' ? 'active' : ''}><span class="ico">📣</span>动态</a>
        <a href="/papers/" class={active === 'papers' ? 'active' : ''}><span class="ico">📚</span>论文库</a>
        <a href="/specials/" class={active === 'specials' ? 'active' : ''}><span class="ico">🧭</span>专题</a>
      </div>
    </nav>
    <script is:inline>
      (function () {
        function syncIcon() {
          var dark = document.documentElement.dataset.theme !== 'light';
          var a = document.getElementById('themeToggle');
          var b = document.getElementById('themeToggleM');
          if (a) a.textContent = dark ? '🌙 深色主题' : '☀️ 浅色主题';
          if (b) b.textContent = dark ? '🌙' : '☀️';
        }
        function bind(id) {
          var el = document.getElementById(id);
          if (el) el.addEventListener('click', function () {
            var t = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
            document.documentElement.dataset.theme = t;
            try { localStorage.setItem('qo-theme', t); } catch (e) {}
            syncIcon();
          });
        }
        bind('themeToggle'); bind('themeToggleM'); syncIcon();
      })();
    </script>
  </body>
</html>
