---
// 数字小药丸:85+ 强调色、70+ 灰底、其余素色。论文显示被引数,动态不显示。
interface Props { value: number | null; label?: string; compact?: boolean; class?: string }
const { value, label = '被引', compact = false, class: className = '' } = Astro.props;
if (value === null || value === undefined) return;
const v = Math.round(value);
const tier = v >= 85 ? 'bg-accent-soft text-accent ring-accent/20' : v >= 20 ? 'bg-bg-sunk text-ink-2 ring-line dark:bg-bg-muted/60' : 'text-ink-4 ring-line-soft';
---
<span title={`${label} ${v}`} class:list={['inline-flex h-[20px] shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-2 ring-1 ring-inset', tier, className]}>
  {!compact && (<>
    <span class="text-[11px] font-medium leading-none opacity-80">{label}</span>
    <span class="h-2.5 w-px bg-current opacity-25" aria-hidden="true"></span>
  </>)}
  <span class="mono text-[12.5px] font-bold leading-none tabular-nums">{v}</span>
</span>
