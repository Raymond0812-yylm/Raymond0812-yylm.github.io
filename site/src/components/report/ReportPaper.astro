---
// 报纸式报告版式:报头(报眉+题字+报眼)+ 数据带 + 头版(头条+看点+版面索引)+ 分版双栏故事
// + 邻期导航 + 版权行。移植自 AIHOT features/report/ReportPaper.tsx 的结构。
import Icon from '../Icon.astro';
import Badge from '../ui/Badge.astro';
import SourceAvatar from '../ui/SourceAvatar.astro';
import Kicker from '../ui/Kicker.astro';

interface Story {
  source: string;
  date?: string;
  title: string;
  summary?: string;
  href?: string;
  url?: string;
  badge?: string;
}
interface Section {
  id: string;
  label: string;
  summary?: string;
  stories: Story[];
}
interface Props {
  kind: 'daily' | 'weekly' | 'monthly';
  issue: number | null;
  dateLine: string;
  markFigure: string;
  markTop: string;
  markBottom: string;
  metrics: Array<{ value: string; unit: string }>;
  readingMinutes?: number;
  highlights: Array<{ title: string; href: string; note?: string }>;
  sections: Section[];
  bodyHtml?: string | null;
  bodyTitle?: string;
  neighbours?: { prev?: { href: string; label: string } | null; next?: { href: string; label: string } | null };
  dots?: Array<{ date: string; on: boolean }>;
}
const { kind, issue, dateLine, markFigure, markTop, markBottom, metrics, readingMinutes, highlights, sections, bodyHtml = null, bodyTitle = '完整解读', neighbours = {}, dots = [] } = Astro.props;
const NAMEPLATE = { daily: '量子优化日报', weekly: '量子优化周报', monthly: '量子优化月报' }[kind];
const MOTTO = { daily: '追踪量子求解最前沿', weekly: '一周研究综述', monthly: '月度研究档案' }[kind];
const EDITION = { daily: '晨报', weekly: '第壹版', monthly: '合订本' }[kind];
const KIND_UP = { daily: '日报', weekly: '周报', monthly: '月报' }[kind];
const seen = new Set<string>();
const pages = sections
  .map((s, i) => ({ ...s, id: s.id || `s-${i + 1}`, stories: s.stories.filter((st) => { const k = st.title; if (seen.has(k)) return false; seen.add(k); return true; }) }))
  .filter((p) => p.stories.length > 0);
---
<article class="report-shell mx-auto max-w-[880px] pb-10 pt-4 lg:pt-6">
  <!-- 报眉 -->
  <header>
    <div class="flex items-center justify-between gap-4 border-b border-line pb-2.5 text-[12px] text-ink-4">
      <span class="num">{dateLine}</span>
      <span class="hidden tracking-[0.3em] sm:inline">{MOTTO}</span>
      <span>{EDITION}</span>
    </div>

    <div class="flex items-stretch justify-between gap-5 py-6 sm:gap-10 sm:py-8">
      <div class="flex min-w-0 flex-col justify-center">
        <h1 class="font-black leading-none tracking-[0.06em] text-ink">
          <span class="block text-[40px] sm:text-[56px] lg:text-[72px]">{NAMEPLATE}</span>
        </h1>
        <p class="mt-3 text-[11.5px] tracking-[0.36em] text-ink-4">QUANTOPT DAILY</p>
      </div>
      <!-- 报眼:期号与大字日期 -->
      <div class="flex shrink-0 items-stretch well rounded-panel">
        <div class="flex w-[118px] flex-col items-center justify-center px-2 py-3 text-center sm:w-[150px] sm:py-4">
          {issue && <span class="text-[11px] tracking-[0.2em] text-ink-4">第 {issue} 期</span>}
          <span class="num mt-2 whitespace-nowrap text-[44px] font-black leading-[0.95] tracking-[-0.04em] text-ink sm:text-[60px]">{markFigure}</span>
          <span class="mt-2 text-[11.5px] text-ink-2">{markTop}</span>
          <span class="text-[11.5px] text-ink-4">{markBottom}</span>
          {dots.length > 0 && (
            <span class="mt-3 flex flex-wrap justify-center gap-1" aria-hidden="true">
              {dots.map((d) => <span class:list={['size-[5px] rounded-full', d.on ? 'bg-accent' : 'bg-line']}></span>)}
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- 数据带 -->
    <div class="flex flex-wrap items-baseline gap-x-8 gap-y-1.5 border-y border-line-strong py-3">
      {metrics.map((m) => (
        <span class="inline-flex items-baseline gap-1.5 whitespace-nowrap">
          <span class="num text-[22px] font-bold leading-none tracking-[-0.02em] text-ink sm:text-[24px]">{m.value}</span>
          <span class="text-[12px] text-ink-4">{m.unit}</span>
        </span>
      ))}
      {readingMinutes && <span class="ml-auto whitespace-nowrap text-[12px] text-ink-4">约 {readingMinutes} 分钟读完</span>}
    </div>
  </header>

  <!-- 头版:今日看点 -->
  {highlights.length > 0 && (
    <section class="mt-6" aria-label="本期看点">
      <Kicker>本期看点</Kicker>
      <ol class="mt-3.5 space-y-2.5">
        {highlights.map((h, i) => (
          <li class="flex items-baseline gap-3">
            <span class="num shrink-0 text-[13px] font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <a href={h.href} class="min-w-0 text-[15.5px] font-semibold leading-[1.6] text-ink transition-colors hover:text-accent">{h.title}</a>
            {h.note && <span class="hidden shrink-0 text-[12px] text-ink-4 sm:inline">{h.note}</span>}
          </li>
        ))}
      </ol>
      {pages.length > 1 && (
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line-soft pt-3 text-[12.5px] text-ink-4">
          <span class="font-semibold text-ink-3">版面</span>
          {pages.map((p) => (
            <a href={`#${p.id}`} class="transition-colors hover:text-accent">{p.label}<span class="ml-0.5 num">{p.stories.length}</span></a>
          ))}
        </div>
      )}
    </section>
  )}

  <!-- 分版故事:双栏报纸行,发丝线分隔 -->
  {pages.map((p) => (
    <section id={p.id} class="mt-8 scroll-mt-20">
      <div class="flex items-baseline justify-between border-b border-line-strong pb-2">
        <h2 class="text-[17px] font-bold tracking-[-0.01em] text-ink">{p.label}</h2>
        {p.summary && <span class="hidden text-[12.5px] text-ink-4 sm:inline">{p.summary}</span>}
      </div>
      <div>
        {(() => {
          const rows: Story[][] = [];
          for (let i = 0; i < p.stories.length; i += 2) rows.push(p.stories.slice(i, i + 2));
          return rows.map((row) => (
            <div class="grid border-b border-line sm:grid-cols-2">
              {row.map((st, i) => (
                <article class:list={['flex min-w-0 flex-col py-6', i === 0 ? 'sm:pr-10' : 'border-t border-line sm:border-l sm:border-t-0 sm:pl-10']}>
                  <div class="flex items-center gap-2 text-[12px] text-ink-3">
                    <span class="inline-flex min-w-0 items-center gap-1.5">
                      <SourceAvatar name={st.source || '?'} size={16} />
                      <span class="truncate">{st.source}</span>
                    </span>
                    {st.badge && <Badge tone="accent">{st.badge}</Badge>}
                    {st.date && <span class="num ml-auto shrink-0 text-ink-4">{st.date}</span>}
                  </div>
                  <h3 class="mt-3 text-[19px] font-bold leading-[1.5] tracking-[-0.01em] text-ink [overflow-wrap:anywhere] sm:text-[20px]">
                    {st.href ? <a href={st.href} class="transition-colors hover:text-accent">{st.title}</a> : st.title}
                  </h3>
                  {st.summary && <p class="mt-2 line-clamp-4 text-[15px] leading-[1.85] text-ink-2 [overflow-wrap:anywhere]">{st.summary}</p>}
                  <div class="mt-auto flex items-center gap-4 pt-3">
                    {st.url && <a href={st.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-7 items-center gap-0.5 text-[12.5px] font-medium text-ink-3 transition-colors hover:text-accent">原文 <Icon name="arrow-up-right" size={12} /></a>}
                    {st.href && st.url && <a href={st.href} class="inline-flex min-h-7 items-center gap-0.5 text-[12.5px] font-medium text-ink-3 transition-colors hover:text-accent">{KIND_UP}全文 <Icon name="arrow-right" size={12} /></a>}
                  </div>
                </article>
              ))}
            </div>
          ));
        })()}
      </div>
    </section>
  ))}

  <!-- 完整解读(日报的 markdown 正文) -->
  {bodyHtml && (
    <section class="mt-10 border-t border-line-strong pt-6">
      <Kicker>{bodyTitle}</Kicker>
      <div class="prose mt-4" set:html={bodyHtml} />
    </section>
  )}

  <!-- 邻期导航 + 版权行 -->
  <nav class="mt-10 flex items-center justify-between gap-4 border-t border-line-strong pt-4 text-[13px]">
    {neighbours.prev ? (
      <a href={neighbours.prev.href} class="group inline-flex min-w-0 items-center gap-1.5 font-medium text-ink-3 transition-colors hover:text-accent">
        <Icon name="chevron-right" size={13} class="rotate-180" /><span class="truncate">上一期 · {neighbours.prev.label}</span>
      </a>
    ) : <span></span>}
    {neighbours.next ? (
      <a href={neighbours.next.href} class="group inline-flex min-w-0 items-center gap-1.5 font-medium text-ink-3 transition-colors hover:text-accent">
        <span class="truncate">下一期 · {neighbours.next.label}</span><Icon name="chevron-right" size={13} />
      </a>
    ) : <span></span>}
  </nav>
  <p class="mt-6 text-center text-[11.5px] tracking-[0.2em] text-ink-4">QUANTOPT DAILY · 量子优化日报 · 每日自动汇编</p>
</article>
