---
// 全部动态流:/all/、/all/papers/、/all/news/ 及其分页 /…/page/N/。
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import PillTabs from '../../components/ui/PillTabs.astro';
import FeedList from '../../components/feed/FeedList.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const data: any = (await import('../../data/site.json')).default;
  const PER = 25;
  const paths: any[] = [];
  const cats: Array<{ key: string; label: string }> = [
    { key: '', label: '全部动态' },
    { key: 'papers', label: '论文进展' },
    { key: 'news', label: '行业动态' },
  ];
  for (const c of cats) {
    const items = c.key ? data.items.filter((it: any) => it.categories.includes(c.key)) : data.items;
    const pageCount = Math.max(1, Math.ceil(items.length / PER));
    for (let p = 1; p <= pageCount; p++) {
      const slug = [c.key, p > 1 ? 'page' : '', p > 1 ? String(p) : ''].filter(Boolean).join('/');
      paths.push({ params: { slug: slug || undefined }, props: { cat: c.key, label: c.label, page: p, pageCount, items: items.slice((p - 1) * PER, p * PER) } });
    }
  }
  return paths;
}

const { cat, label, page, pageCount, items } = Astro.props as any;
const data: any = site;
const featured = data.items.filter((it: any) => it.selected);
const papersCount = featured.filter((it: any) => it.kind === 'paper').length;
const newsCount = featured.filter((it: any) => it.kind === 'news').length;
const today = data.items[0]?.date ?? '';
const title = page > 1 ? `${label} · 第 ${page} 页` : label;
---
<Shell title={title} path={`/all/${cat ? cat + '/' : ''}`}>
  <header class="hidden lg:block">
    <div class="flex items-center justify-between">
      <h1 class="text-[22px] font-bold tracking-[-0.01em] text-ink">{label}</h1>
      <form action="/search/" method="get" class="relative">
        <Icon name="search" size={15} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-4" />
        <input type="search" name="q" placeholder="搜索论文与动态…" class="h-9 w-[220px] rounded-full border border-line bg-field pl-9 pr-3 text-[13.5px] text-ink placeholder:text-ink-4 focus:border-line-strong focus:outline-none xl:w-[260px]" />
      </form>
    </div>
    <div class="mt-3.5 flex items-center justify-between gap-4">
      <PillTabs
        label="分类"
        active={cat || 'all'}
        items={[
          { key: 'all', label: '全部', to: '/all/' },
          { key: 'papers', label: '论文进展', to: '/all/papers/', count: papersCount },
          { key: 'news', label: '行业动态', to: '/all/news/', count: newsCount },
        ]}
      />
      <span class="num whitespace-nowrap text-[12px] text-ink-4">{page}/{pageCount} 页</span>
    </div>
  </header>

  <header class="lg:hidden">
    <div class="flex items-center justify-between">
      <h1 class="text-[21px] font-bold tracking-[-0.01em] text-ink">{label}</h1>
      <span class="num text-[12px] text-ink-4">{page}/{pageCount} 页</span>
    </div>
    <div class="-mx-4 mt-3 overflow-x-auto px-4 scrollbar-none">
      <PillTabs
        size="sm"
        label="分类"
        active={cat || 'all'}
        items={[
          { key: 'all', label: '全部', to: '/all/' },
          { key: 'papers', label: '论文进展', to: '/all/papers/' },
          { key: 'news', label: '行业动态', to: '/all/news/' },
        ]}
      />
    </div>
  </header>

  <div class="mt-4 lg:mt-5">
    <FeedList items={items} today={today} showTags={true} page={page} pageCount={pageCount} hrefBase={cat ? `/all/${cat}/` : '/all/'} />
  </div>
</Shell>
