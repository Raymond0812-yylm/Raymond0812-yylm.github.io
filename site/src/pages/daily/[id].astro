---
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';
import { fmtAuthors } from '../../lib/utils.js';

const data: any = siteData;
export function getStaticPaths() {
  return (siteData as any).reports.map((report) => ({ params: { id: report.slug }, props: { report } }));
}

const { report } = Astro.props;
const dayPapers = report.paperIds.map((pid: string) => data.papers.find((p: any) => p.id === pid)).filter(Boolean);
const dayPaperCount = dayPapers.length;
const paper = dayPapers[0];
const html = marked.parse(report.markdown, { gfm: true, breaks: false });
const idx = data.reports.findIndex((r: any) => r.slug === report.slug);
const newer = idx > 0 ? data.reports[idx - 1] : null;
const older = idx < data.reports.length - 1 ? data.reports[idx + 1] : null;
---

<Base active="daily" title={report.titleZh} description={report.summaryZh}>
  <div class="page-head" style="padding-bottom:6px">
    <div class="crumbs"><a href="/">首页</a><span>/</span><a href="/daily/">每日报告</a><span>/</span>{report.date}</div>
    <h1>{report.titleZh}</h1>
    <p class="lead small muted" style="margin-top:8px">
      {report.date} · {report.venue}{report.arxivId ? ` · arXiv:${report.arxivId}` : ''} · {fmtAuthors(report.authors)}
    </p>
  </div>

  <div class="panel toc-box">
    <h2>今日看点 <span class="muted small" style="font-weight:500">{dayPaperCount} 篇 · 约 {Math.max(2, dayPaperCount * 2)} 分钟读完</span></h2>
    {dayPapers.map((p: any, i: number) => (
      <div class="toc-row">
        <span class="no">{String(i + 1).padStart(2, '0')}</span>
        <div style="min-width:0">
          <a href={`/papers/${p.id}/`} style="font-weight:700">{p.titleZh}</a>
          <div class="small muted" style="display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden">{p.summaryZh}</div>
        </div>
      </div>
    ))}
  </div>

  <div class="report-body" set:html={html} />

  <div style="display:flex;justify-content:space-between;gap:12px;margin-top:22px;flex-wrap:wrap">
    {older ? <a class="btn" href={`/daily/${older.slug}/`}>← 上一期({older.date})</a> : <span></span>}
    {paper?.url && <a class="btn" href={paper.url} target="_blank" rel="noopener">论文原文 ↗</a>}
    {newer ? <a class="btn" href={`/daily/${newer.slug}/`}>下一期({newer.date}) →</a> : <span></span>}
  </div>
</Base>
