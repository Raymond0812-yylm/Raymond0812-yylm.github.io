---
// 日报详情:报纸式版式(报头+看点+分版故事+完整解读)。
import { marked } from 'marked';
import Shell from '../../layouts/Shell.astro';
import ReportPaper from '../../components/report/ReportPaper.astro';
import siteData from '../../data/site.json';

const data: any = siteData;
export function getStaticPaths() {
  return (siteData as any).reports.map((report) => ({ params: { id: report.slug }, props: { report } }));
}

const { report } = Astro.props;
const dayPapers = report.paperIds.map((pid: string) => data.papers.find((p: any) => p.id === pid)).filter(Boolean);
const idx = data.reports.findIndex((r: any) => r.slug === report.slug);
const newer = idx > 0 ? data.reports[idx - 1] : null;
const older = idx < data.reports.length - 1 ? data.reports[idx + 1] : null;
const html = marked.parse(report.markdown, { gfm: true, breaks: false });

const WEEKDAY = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
const [, m, d] = report.date.split('-').map(Number);
const weekday = WEEKDAY[new Date(`${report.date}T12:00:00+08:00`).getUTCDay()];
// 近 14 天出版点(有日报为实点)
const dates14: Array<{ date: string; on: boolean }> = [];
{
  const base = new Date(`${data.reports[0]?.date || report.date}T12:00:00Z`);
  for (let i = 13; i >= 0; i--) {
    const dt = new Date(base);
    dt.setUTCDate(base.getUTCDate() - i);
    const ds = dt.toISOString().slice(0, 10);
    dates14.push({ date: ds, on: data.reports.some((r: any) => r.date === ds) });
  }
}
const stories = dayPapers.map((p: any) => ({
  source: p.venue || 'arXiv 预印本',
  title: p.titleZh || p.title,
  summary: p.summaryZh,
  href: `/papers/${p.id}/`,
  url: p.url || (p.arxivId ? `https://arxiv.org/abs/${p.arxivId}` : ''),
  badge: (p.citations ?? 0) >= 20 ? `被引 ${p.citations}` : undefined,
}));
const sections = dayPapers.map((p: any, i: number) => ({
  id: `s-${i + 1}`,
  label: `第${['一', '二', '三', '四', '五', '六'][i] || i + 1}版 · ${p.titleZh.slice(0, 14)}…`,
  stories: [stories[i]],
}));
---
<Shell title={`日报 · ${report.date}`} description={report.summaryZh?.slice(0, 80)} path="/daily/">
  <ReportPaper
    kind="daily"
    issue={data.reports.length - idx}
    dateLine={`${report.date} · ${weekday}`}
    markFigure={`${m}.${d}`}
    markTop={`${report.date.slice(0, 4)} 年`}
    markBottom={`第 ${data.reports.length - idx} 期`}
    metrics={[
      { value: String(dayPapers.length), unit: '篇论文' },
      { value: String(dayPapers.reduce((s: number, p: any) => s + (p.citations || 0), 0) || '—'), unit: '累计被引' },
    ]}
    readingMinutes={Math.max(2, dayPapers.length * 2)}
    highlights={dayPapers.map((p: any) => ({ title: p.titleZh || p.title, href: `/papers/${p.id}/`, note: (p.citations ? `被引 ${p.citations}` : '') || undefined }))}
    sections={sections}
    bodyHtml={html}
    bodyTitle="完整解读"
    neighbours={{
      prev: older ? { href: `/daily/${older.slug}/`, label: older.date } : null,
      next: newer ? { href: `/daily/${newer.slug}/`, label: newer.date } : null,
    }}
    dots={dates14}
  />
</Shell>
