---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { groupByMonth, monthLabel } from '../../lib/utils.js';

const { reports, topics } = site as any;
const months = groupByMonth(reports);
---

<Base active="daily" title="每日报告" description="量子优化方向的每日精选论文中文深度解读报告归档">
  <div class="page-head">
    <div class="crumbs"><a href="/">首页</a><span>/</span>每日报告</div>
    <h1>每日报告</h1>
    <p class="lead">
      每天从最新公布的论文中精选最具代表性的若干篇工作(通常 1 篇深度解读 + 1~2 篇简要推荐),
      生成包含研究背景、方法路线、主要结果与领域启示的中文解读;当日无合适的量子方向新作时,
      自动转向大模型赋能优化方向。论文之外的产业进展见<a href="/news/">行业动态</a>。
    </p>
  </div>

  {months.map(([ym, list]) => (
    <div class="month">
      <h2>{monthLabel(ym)}</h2>
      {list.map((r: any) => (
        <div class="report-row">
          <div class="d">{r.date}</div>
          <div>
            <div class="t">
              <a href={`/daily/${r.slug}/`}>{r.titleZh}</a>
              {r.topics.slice(0, 1).map((t) => <a class={`badge t-${t}`} href={`/topics/${t}/`} style="margin-left:8px;vertical-align:2px">{topics[t]?.label}</a>)}
            </div>
            <div class="e">{r.titleEn} · {r.venue}{r.arxivId ? ` · arXiv:${r.arxivId}` : ''}</div>
            <p class="s">{r.summaryZh}</p>
          </div>
        </div>
      ))}
    </div>
  ))}
</Base>
