---
// 日报归档:报纸期号清单。
import Shell from '../../layouts/Shell.astro';
import PillTabs from '../../components/ui/PillTabs.astro';
import ArchiveList from '../../components/report/ArchiveList.astro';
import site from '../../data/site.json';

const reports = [...(site as any).reports].reverse(); // 最早→最新,使期号 #1 在最前
const total = reports.length;
---
<Shell title="日报" description="量子优化方向的每日精选论文中文深度解读,报纸式归档" path="/daily/">
  <header class="hidden lg:block">
    <h1 class="text-[22px] font-bold tracking-[-0.01em] text-ink">日报</h1>
    <div class="mt-3.5">
      <PillTabs label="报告类型" active="daily" items={[
        { key: 'daily', label: '日报', to: '/daily/' },
        { key: 'weekly', label: '周报', to: '/weekly/' },
        { key: 'monthly', label: '月报', to: '/monthly/' },
      ]} />
    </div>
  </header>
  <header class="lg:hidden">
    <h1 class="text-[21px] font-bold tracking-[-0.01em] text-ink">日报</h1>
    <div class="-mx-4 mt-3 overflow-x-auto px-4 scrollbar-none">
      <PillTabs size="sm" label="报告类型" active="daily" items={[
        { key: 'daily', label: '日报', to: '/daily/' },
        { key: 'weekly', label: '周报', to: '/weekly/' },
        { key: 'monthly', label: '月报', to: '/monthly/' },
      ]} />
    </div>
  </header>
  <p class="mt-3 text-[13px] leading-relaxed text-ink-3 lg:mt-4">
    每天精选 1~3 篇最具代表性的工作,生成研究背景、方法路线、主要结果与领域启示的中文解读;
    当日无合适的量子方向新作时,自动转向大模型赋能优化方向。共 {total} 期。
  </p>
  <ArchiveList issues={reports.map((r: any, i: number) => ({ href: `/daily/${r.slug}/`, issue: i + 1, date: r.date, title: r.titleZh, note: `${r.paperCount} 篇` }))} />
</Shell>
