---
// 首页「精选」:分类 Tabs + 搜索 → 当前热点 → 按天分组信息流。移植自 AIHOT routes/home.tsx。
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import PillTabs from '../components/ui/PillTabs.astro';
import HotTopics from '../components/feed/HotTopics.astro';
import DayHeader from '../components/feed/DayHeader.astro';
import TimelineSlot from '../components/feed/TimelineSlot.astro';
import FeedItem from '../components/feed/FeedItem.astro';
import site from '../data/site.json';

const featured = (site as any).items.filter((it: any) => it.selected);
const today = featured[0]?.date ?? '';
// 按天分组,首页展示最近 12 天,更早的引导到 /all/
const days: Array<{ day: string; items: any[] }> = [];
for (const it of featured) {
  const last = days[days.length - 1];
  if (last && last.day === it.date) last.items.push(it);
  else if (days.length < 12) days.push({ day: it.date, items: [it] });
  else break;
}
const papersCount = featured.filter((it: any) => it.kind === 'paper').length;
const newsCount = featured.filter((it: any) => it.kind === 'news').length;
---
<Shell title="精选">
  <!-- 桌面页头:标题 + 分类 Tabs + 搜索框 -->
  <header class="hidden lg:block">
    <div class="flex items-center justify-between">
      <h1 class="text-[22px] font-bold tracking-[-0.01em] text-ink">精选</h1>
      <form action="/search/" method="get" class="relative">
        <Icon name="search" size={15} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-4" />
        <input
          type="search"
          name="q"
          placeholder="搜索论文与动态…"
          class="h-9 w-[220px] rounded-full border border-line bg-field pl-9 pr-3 text-[13.5px] text-ink placeholder:text-ink-4 focus:border-line-strong focus:outline-none xl:w-[260px]"
        />
      </form>
    </div>
    <div class="mt-3.5">
      <PillTabs
        label="分类"
        active="all"
        items={[
          { key: 'all', label: '全部精选', to: '/' },
          { key: 'papers', label: '论文进展', to: '/all/papers/', count: papersCount },
          { key: 'news', label: '行业动态', to: '/all/news/', count: newsCount },
        ]}
      />
    </div>
  </header>

  <!-- 手机页头:标题 + 横向 Tabs -->
  <header class="lg:hidden">
    <div class="flex items-center justify-between">
      <h1 class="text-[21px] font-bold tracking-[-0.01em] text-ink">精选</h1>
      <span class="text-[12px] text-ink-4">今日 {days[0]?.items.length ?? 0} 条</span>
    </div>
    <div class="-mx-4 mt-3 overflow-x-auto px-4 scrollbar-none">
      <PillTabs
        size="sm"
        label="分类"
        active="all"
        items={[
          { key: 'all', label: '全部精选', to: '/' },
          { key: 'papers', label: '论文进展', to: '/all/papers/', count: papersCount },
          { key: 'news', label: '行业动态', to: '/all/news/', count: newsCount },
        ]}
      />
    </div>
  </header>

  <!-- 当前热点 -->
  <div class="mt-4 lg:mt-5">
    <HotTopics entries={(site as any).hot.slice(0, 5)} />
  </div>

  <!-- 按天分组信息流 -->
  {days.map(({ day, items }, di) => (
    <section aria-label={day} class="mt-2">
      <DayHeader day={day} today={today} count={day === today ? days[0].items.length : null} />
      <ol class="lg:pt-1">
        {items.map((it: any, ii: number) => (
          <TimelineSlot kind={it.kind} last={di === days.length - 1 && ii === items.length - 1}>
            <FeedItem item={it} showTags={true} />
          </TimelineSlot>
        ))}
      </ol>
    </section>
  ))}

  <div class="mt-6 flex justify-center">
    <a href="/all/" class="inline-flex h-10 items-center gap-1.5 rounded-full border border-line-strong bg-surface px-5 text-[13.5px] font-medium text-ink-2 transition-colors hover:border-ink-4 hover:text-ink">
      查看更早的全部动态 <Icon name="arrow-right" size={14} />
    </a>
  </div>
</Shell>
