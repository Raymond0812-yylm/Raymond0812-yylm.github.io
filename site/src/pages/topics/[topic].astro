---
import Base from '../../layouts/Base.astro';
import PaperCard from '../../components/PaperCard.astro';
import siteData from '../../data/site.json';
import { TOPIC_COLOR } from '../../lib/utils.js';

const data: any = siteData;
export function getStaticPaths() {
  return Object.keys((siteData as any).topics).map((topic) => ({ params: { topic }, props: { topic } }));
}

const { topic } = Astro.props;
const { topics, papers } = data;
const meta = topics[topic];
const inTopic = papers.filter((p: any) => p.topics.includes(topic));
const featured = inTopic.filter((p: any) => p.featured);
const foundational = inTopic.filter((p: any) => p.tags.includes('foundational')).sort((a: any, b: any) => (b.citations || 0) - (a.citations || 0));
const recent = inTopic.filter((p: any) => !p.tags.includes('foundational')).sort((a: any, b: any) => (a.date < b.date ? 1 : -1));
---

<Base active="topics" title={meta.label} description={meta.desc}>
  <div class="page-head">
    <div class="crumbs"><a href="/">首页</a><span>/</span><a href="/topics/">研究方向</a><span>/</span>{meta.label}</div>
    <h1 style={`color:${TOPIC_COLOR[topic]}`}>{meta.label}</h1>
    <p class="lead">{meta.desc}</p>
    <p class="small muted">共 {inTopic.length} 篇 · 其中日报精选 {featured.length} 篇 · 领域奠基 {foundational.length} 篇</p>
  </div>

  {featured.length > 0 && (
    <section class="section">
      <div class="section-head"><h2><span class="bar"></span>日报精选</h2></div>
      <div class="grid">{featured.map((p: any) => <PaperCard paper={p} />)}</div>
    </section>
  )}

  {foundational.length > 0 && (
    <section class="section">
      <div class="section-head"><h2><span class="bar"></span>奠基文献</h2><span class="more">按引用排序</span></div>
      <div class="grid">{foundational.map((p: any) => <PaperCard paper={p} compact />)}</div>
    </section>
  )}

  <section class="section">
    <div class="section-head"><h2><span class="bar"></span>全部论文</h2><span class="more">按时间排序</span></div>
    <div class="grid">{recent.map((p: any) => <PaperCard paper={p} />)}</div>
  </section>
</Base>
