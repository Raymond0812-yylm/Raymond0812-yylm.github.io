---
// 月报详情:报纸式版式。月度主线 + 分方向版面。
import Shell from '../../layouts/Shell.astro';
import ReportPaper from '../../components/report/ReportPaper.astro';
import siteData from '../../data/site.json';
import { groupByMonth } from '../../lib/periods.js';

const data: any = siteData;
export function getStaticPaths() {
  return groupByMonth((siteData as any).papers).map((month: any) => ({ params: { month: month.key }, props: { month } }));
}

const { month } = Astro.props;
const topics = data.topics;
const papers = [...month.papers].sort((a: any, b: any) => (b.citations || 0) - (a.citations || 0));
const reportsIn = (data.reports || []).filter((r: any) => r.date.startsWith(month.key));
const allMonths = groupByMonth(data.papers);
const mIdx = allMonths.findIndex((m: any) => m.key === month.key);
const newer = mIdx < allMonths.length - 1 ? allMonths[mIdx + 1] : null;
const older = mIdx > 0 ? allMonths[mIdx - 1] : null;

const topicCount: any = {};
for (const p of papers) for (const t of p.topics) topicCount[t] = (topicCount[t] || 0) + 1;
const topTopics = Object.entries(topicCount).sort((a: any, b: any) => (b[1] as number) - (a[1] as number)).slice(0, 3).map(([t]) => topics[t]?.label ?? t);
const topCited = papers[0];
const newsCount = (data.news || []).filter((n: any) => n.date.startsWith(month.key)).reduce((s: number, n: any) => s + n.count, 0);
const mainLine = `本月共收录 ${papers.length} 篇论文、${newsCount} 条行业动态` +
  (topTopics.length ? `,热点集中在「${topTopics.join('」「')}」等方向` : '') +
  (topCited?.citations ? `;最受关注的工作为《${topCited.titleZh}》(被引 ${topCited.citations} 次)` : '') + '。';

const storyOf = (p: any) => ({
  source: p.venue || 'arXiv 预印本',
  date: p.date?.slice(5),
  title: p.titleZh || p.title,
  summary: p.summaryZh,
  href: `/papers/${p.id}/`,
  url: p.url || (p.arxivId ? `https://arxiv.org/abs/${p.arxivId}` : ''),
  badge: (p.citations || 0) >= 20 ? `被引 ${p.citations}` : undefined,
});
const sections: any[] = [];
const topTopicKeys = Object.entries(topicCount).sort((a: any, b: any) => (b[1] as number) - (a[1] as number)).slice(0, 6);
for (const [tk, cnt] of topTopicKeys) {
  const list = papers.filter((p: any) => p.topics.includes(tk)).slice(0, 10);
  if (!list.length) continue;
  sections.push({ id: `s-${tk}`, label: `${topics[tk]?.label ?? tk}版`, summary: `${cnt} 篇`, stories: list.map(storyOf) });
}
const highlights = papers.slice(0, 4).map((p: any) => ({ title: p.titleZh || p.title, href: `/papers/${p.id}/`, note: p.citations ? `被引 ${p.citations}` : undefined }));
const fmtMonth = (ym: string) => `${ym.slice(0, 4)} 年 ${Number(ym.slice(5))} 月`;
---
<Shell title={`月报 · ${fmtMonth(month.key)}`} description={`量子优化月报 ${fmtMonth(month.key)},共 ${papers.length} 篇论文`} path="/monthly/">
  <ReportPaper
    kind="monthly"
    issue={allMonths.length - mIdx}
    dateLine={`${month.key}-01 ~ ${month.key}-31`}
    markFigure={month.key.slice(5)}
    markTop={`${month.key.slice(0, 4)} 年`}
    markBottom={`第 ${allMonths.length - mIdx} 期`}
    metrics={[
      { value: String(papers.length), unit: '篇论文' },
      { value: String(reportsIn.length), unit: '期日报' },
      { value: String(newsCount), unit: '条动态' },
    ]}
    readingMinutes={Math.max(3, Math.ceil(papers.length / 10))}
    highlights={highlights}
    sections={sections}
    bodyHtml={null}
    neighbours={{
      prev: older ? { href: `/monthly/${older.key}/`, label: older.key } : null,
      next: newer ? { href: `/monthly/${newer.key}/`, label: newer.key } : null,
    }}
  />
  <div class="mx-auto max-w-[880px]">
    <section class="well mt-2 rounded-panel p-4 lg:p-5">
      <p class="text-[13.5px] leading-[1.8] text-ink-2"><strong class="font-semibold">本月主线:</strong>{mainLine}</p>
    </section>
  </div>
</Shell>
