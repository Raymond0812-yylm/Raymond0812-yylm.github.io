---
import PeriodIndex from '../../components/report/PeriodIndex.astro';
import siteData from '../../data/site.json';
import { groupByMonth } from '../../lib/periods.js';

const data: any = siteData;
const months = groupByMonth(data.papers); // 新→旧
const all = [...months].reverse();
const fmt = (ym: string) => `${ym.slice(0, 4)} 年 ${Number(ym.slice(5))} 月`;
---
<PeriodIndex
  kind="monthly"
  label="月报"
  desc="每月 1 日自动综合上月全部收录,按研究方向分版,含月度主线。"
  issues={months.map((m: any, i: number) => ({ href: `/monthly/${m.key}/`, issue: all.length - i, date: fmt(m.key), title: `${m.papers.length} 篇论文月度汇编`, note: `${m.papers.length} 篇` }))}
/>
