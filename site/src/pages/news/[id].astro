---
// 当日行业动态全文页。
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import SourceAvatar from '../../components/ui/SourceAvatar.astro';
import Kicker from '../../components/ui/Kicker.astro';
import siteData from '../../data/site.json';

const data: any = siteData;
export function getStaticPaths() {
  return (siteData as any).news.map((day: any) => ({ params: { id: day.slug }, props: { day } }));
}

const { day } = Astro.props;
const idx = data.news.findIndex((n: any) => n.slug === day.slug);
const newer = idx > 0 ? data.news[idx - 1] : null;
const older = idx < data.news.length - 1 ? data.news[idx + 1] : null;
---
<Shell title={`行业动态 · ${day.date}`} description={`${day.date} 量子计算产业动态 ${day.count} 条`} path="/news/">
  <div class="mx-auto max-w-[760px]">
    <div class="flex items-center gap-2 text-[12.5px] text-ink-4">
      <a href="/news/" class="transition-colors hover:text-accent">行业动态</a>
      <span aria-hidden="true">/</span>
      <span class="num">{day.date}</span>
    </div>
    <h1 class="mt-2 text-[24px] font-bold tracking-[-0.01em] text-ink">{day.date} 产业动态</h1>
    <p class="mt-2 text-[13px] text-ink-4">{day.count} 条要闻 · 摘要为中文编译,准确信息以来源为准</p>

    {['国际', '国内'].map((region) => {
      const items = day.items.filter((it: any) => (it.region || '国际') === region);
      if (!items.length) return null;
      return (
        <section class="mt-7" aria-label={region}>
          <Kicker>{region === '国际' ? '国际动态' : '国内动态'}</Kicker>
          <div class="mt-3 space-y-4">
            {items.map((it: any, i: number) => (
              <article id={`n${it.newsIdx ?? i}`} class="card p-5">
                <header class="flex flex-wrap items-center gap-2 text-[12px] text-ink-4">
                  <span class="inline-flex items-center gap-1.5"><SourceAvatar name={it.source || '?'} size={16} /><span class="truncate">{it.source}</span></span>
                  <Badge tone="neutral">{it.category}</Badge>
                </header>
                <h2 class="mt-2.5 text-[17.5px] font-bold leading-[1.55] text-ink">{it.title}</h2>
                {it.summary && <p class="mt-2 text-[14.5px] leading-[1.85] text-ink-2">{it.summary}</p>}
                {it.url && (
                  <a href={it.url} target="_blank" rel="noopener" class="mt-3 inline-flex min-h-7 items-center gap-0.5 text-[12.5px] font-medium text-ink-3 transition-colors hover:text-accent">
                    阅读原文 <Icon name="arrow-up-right" size={12} />
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <nav class="mt-10 flex items-center justify-between gap-4 border-t border-line-strong pt-4 text-[13px]">
      {older ? <a href={`/news/${older.slug}/`} class="inline-flex min-w-0 items-center gap-1.5 font-medium text-ink-3 transition-colors hover:text-accent"><Icon name="chevron-right" size={13} class="rotate-180" /><span class="truncate">{older.date}</span></a> : <span></span>}
      {newer ? <a href={`/news/${newer.slug}/`} class="inline-flex min-w-0 items-center gap-1.5 font-medium text-ink-3 transition-colors hover:text-accent"><span class="truncate">{newer.date}</span><Icon name="chevron-right" size={13} /></a> : <span></span>}
    </nav>
  </div>
</Shell>
