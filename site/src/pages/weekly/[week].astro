---
// 周报详情:报纸式版式。本期主线 + 分方向版面 + 深度解读版。
import Shell from '../../layouts/Shell.astro';
import ReportPaper from '../../components/report/ReportPaper.astro';
import siteData from '../../data/site.json';
import { groupByWeek } from '../../lib/periods.js';

const data: any = siteData;
export function getStaticPaths() {
  return groupByWeek((siteData as any).papers).map((week: any) => ({ params: { week: week.key }, props: { week } }));
}

const { week } = Astro.props;
const topics = data.topics;
const papers = [...week.papers].sort((a: any, b: any) => (b.citations || 0) - (a.citations || 0));
const reportsIn = (data.reports || []).filter((r: any) => r.date >= week.range[0] && r.date <= week.range[1]);
const allWeeks = groupByWeek(data.papers);
const wIdx = allWeeks.findIndex((w: any) => w.key === week.key);
const newer = wIdx < allWeeks.length - 1 ? allWeeks[wIdx + 1] : null;
const older = wIdx > 0 ? allWeeks[wIdx - 1] : null;

const topicCount: any = {};
for (const p of papers) for (const t of p.topics) topicCount[t] = (topicCount[t] || 0) + 1;
const topTopics = Object.entries(topicCount).sort((a: any, b: any) => (b[1] as number) - (a[1] as number)).slice(0, 3).map(([t]) => topics[t]?.label ?? t);
const topCited = papers.find((p: any) => p.citations);
const mainLine = `本周共收录 ${papers.length} 篇论文` +
  (topTopics.length ? `,研究热点集中在「${topTopics.join('」「')}」等方向` : '') +
  (topCited?.citations ? `;本期最受关注的工作为《${topCited.titleZh}》(被引 ${topCited.citations} 次)` : '') + '。';

const storyOf = (p: any) => ({
  source: p.venue || 'arXiv 预印本',
  date: p.date?.slice(5),
  title: p.titleZh || p.title,
  summary: p.summaryZh,
  href: `/papers/${p.id}/`,
  url: p.url || (p.arxivId ? `https://arxiv.org/abs/${p.arxivId}` : ''),
  badge: (p.citations || 0) >= 20 ? `被引 ${p.citations}` : undefined,
});
// 版面:深度解读 + 各研究方向(取论文数最多的前 4 个方向)
const sections: any[] = [];
if (reportsIn.length) {
  sections.push({
    id: 's-report', label: '深度解读版',
    summary: '本周日报全文',
    stories: reportsIn.map((r: any) => ({ source: 'QuantOpt 编辑系统', date: r.date?.slice(5), title: r.titleZh, summary: r.summaryZh, href: `/daily/${r.slug}/`, url: '' })),
  });
}
const topTopicKeys = Object.entries(topicCount).sort((a: any, b: any) => (b[1] as number) - (a[1] as number)).slice(0, 4);
for (const [tk, cnt] of topTopicKeys) {
  const list = papers.filter((p: any) => p.topics.includes(tk)).slice(0, 8);
  if (!list.length) continue;
  sections.push({ id: `s-${tk}`, label: `${topics[tk]?.label ?? tk}版`, summary: `${cnt} 篇`, stories: list.map(storyOf) });
}
const highlights = papers.slice(0, 3).map((p: any) => ({ title: p.titleZh || p.title, href: `/papers/${p.id}/`, note: p.citations ? `被引 ${p.citations}` : undefined }));
if (reportsIn.length) {
  for (const r of reportsIn.slice(0, 2)) highlights.unshift({ title: `【日报】${r.titleZh}`, href: `/daily/${r.slug}/` });
}
const weeksTotal = allWeeks.length;
---
<Shell title={`周报 · ${week.key}`} description={`量子优化周报 ${week.range[0]} ~ ${week.range[1]},共 ${papers.length} 篇论文`} path="/weekly/">
  <ReportPaper
    kind="weekly"
    issue={weeksTotal - wIdx}
    dateLine={`${week.range[0]} ~ ${week.range[1]}`}
    markFigure={week.key.slice(5)}
    markTop={`${week.key.slice(0, 4)} 年`}
    markBottom={`W${week.key.slice(6)} · 第 ${weeksTotal - wIdx} 期`}
    metrics={[
      { value: String(papers.length), unit: '篇论文' },
      { value: String(reportsIn.length), unit: '期日报' },
      { value: String(new Set(papers.flatMap((p: any) => p.topics)).size), unit: '个方向' },
    ]}
    readingMinutes={Math.max(2, Math.ceil(papers.length / 12))}
    highlights={highlights.slice(0, 5)}
    sections={sections}
    bodyHtml={null}
    neighbours={{
      prev: older ? { href: `/weekly/${older.key}/`, label: older.key } : null,
      next: newer ? { href: `/weekly/${newer.key}/`, label: newer.key } : null,
    }}
  />
  <div class="mx-auto max-w-[880px]">
    <section class="well mt-2 rounded-panel p-4 lg:p-5">
      <p class="text-[13.5px] leading-[1.8] text-ink-2"><strong class="font-semibold">本期主线:</strong>{mainLine}</p>
    </section>
  </div>
</Shell>
