---
import PeriodIndex from '../../components/report/PeriodIndex.astro';
import siteData from '../../data/site.json';
import { groupByWeek } from '../../lib/periods.js';

const data: any = siteData;
const weeks = groupByWeek(data.papers); // 新→旧
const all = [...weeks].reverse();
const weekTitle = (w: any) => {
  const papers = w.papers;
  const top = [...papers].sort((a: any, b: any) => (b.citations || 0) - (a.citations || 0))[0];
  return top ? `本周主线:${(top.titleZh || top.title).slice(0, 30)}…` : `${w.range[0]} ~ ${w.range[1]}`;
};
---
<PeriodIndex
  kind="weekly"
  label="周报"
  desc="每周一自动综合本周收录的论文与日报,按研究方向分版呈现。"
  issues={weeks.map((w: any, i: number) => ({ href: `/weekly/${w.key}/`, issue: all.length - i, date: w.key.replace('-W', ' 第 ') + ' 周', title: `${w.range[0]} ~ ${w.range[1]}`, note: `${w.papers.length} 篇` }))}
/>
